# ---------------------------------------------------------------- database
# docker compose up -d db  gives you exactly this locally.
DATABASE_URL=postgres://pinball:pinball@127.0.0.1:5432/pinball
# PGSSL=require        # managed Postgres (RDS, Neon, Supabase)

# ------------------------------------------------------------------- app
PORT=8787
HOST=127.0.0.1
# Where the app itself is served. Published sites are *.PINBALL_BASE_DOMAIN.
# Production:  PINBALL_APP_ORIGIN=https://learn.pinball.sh
# Keep this http://localhost in development: an https origin marks the session
# cookie Secure, and the browser then refuses to store it over plain http, which
# makes sign-in silently loop back to the sign-in screen.
PINBALL_APP_ORIGIN=http://localhost:5173
PINBALL_BASE_DOMAIN=pinball.sh

# Signs the session cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------- signin
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add GOOGLE_REDIRECT_URI below as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production:  https://learn.pinball.sh/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Signup is invite-only. Emails, or @domain.com for a whole domain.
PINBALL_ALLOWLIST=
# First sign-in from this address owns the imported data and becomes admin.
PINBALL_BOOTSTRAP_EMAIL=

# Local-only escape hatch: enables POST /api/auth/dev as this address.
# Ignored entirely when NODE_ENV=production.
PINBALL_DEV_LOGIN=

# --------------------------------------------------------------- storage
# local = disk (PINBALL_UPLOADS), s3 = bucket below
PINBALL_STORAGE=local
PINBALL_UPLOADS=

S3_BUCKET=
# AWS: a real region. Cloudflare R2: must be exactly "auto".
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads

# Where the SERVER writes, signed with the keys above. Leave unset on AWS (the
# SDK derives it from S3_REGION). Required for R2/MinIO, and it is the account
# host ONLY -- no bucket in the path, the SDK appends that:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Where BROWSERS read, anonymously. Never the same value as S3_ENDPOINT: that
# one demands SigV4-signed requests and answers a plain <img> with 401. Use a
# CDN or custom domain (CloudFront, or an R2 custom domain like
# https://cdn.pinball.sh). Left empty, the API streams the bytes itself rather
# than redirecting -- correct, but every image then crosses your backend.
S3_PUBLIC_BASE=

# Object ACLs. Leave unset unless you know you need them:
#   - AWS with ACLs disabled (the default for buckets created since 2023):
#     sending one is a hard error, so the upload fails outright.
#   - Cloudflare R2: no object ACLs at all. Public read comes from a custom
#     domain or the r2.dev toggle, never from this header or a bucket policy.
# S3_ACL=public-read
